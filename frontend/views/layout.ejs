<!doctype html>
<html lang="id">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= typeof title !== 'undefined' ? title : 'EngPersona' %></title>
  <link rel="icon" type="image/jpeg" sizes="32x32" href="/wbicon.jpg">
  <link rel="icon" type="image/jpeg" href="/wbicon.jpg">
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
  <link rel="stylesheet" href="/engpersona-ui.css">
  <style>
    :root {
      --ep-primary: #3ac46a;
      --ep-dark: #10231a;
      --ep-accent: #1e6dfb;
      --ep-bg: linear-gradient(120deg, #f5fff8 0%, #f0f6ff 100%);
    }
    body {
      background: var(--ep-bg);
      min-height: 100vh;
    }
    .ep-card {
      border: 0;
      border-radius: 1rem;
      box-shadow: 0 20px 50px rgba(16, 35, 26, 0.08);
    }
    .ep-brand {
      font-weight: 800;
      letter-spacing: 0.3px;
      color: var(--ep-dark);
      display: flex;
      align-items: center;
      gap: 8px;
    }
    .ep-brand .nav-logo {
      width: 36px;
      height: 36px;
      object-fit: contain;
      filter: drop-shadow(0 2px 4px rgba(27, 42, 107, 0.2));
    }
  </style>
</head>
<body class="<%= path === '/exercise' ? 'exercise-focus-page' : '' %>">
<% if (currentUser) { %>
  <nav class="navbar navbar-expand-lg bg-white border-bottom sticky-top">
    <div class="container py-1">
      <a class="navbar-brand ep-brand" href="/dashboard">
        <img class="nav-logo" src="/logo.png" alt="EngPersona">
        EngPersona
      </a>
      <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#mainNav">
        <span class="navbar-toggler-icon"></span>
      </button>
      <div class="collapse navbar-collapse" id="mainNav">
        <ul class="navbar-nav me-auto mb-2 mb-lg-0">
          <li class="nav-item"><a class="nav-link <%= path === '/dashboard' ? 'active' : '' %>" href="/dashboard">Dashboard</a></li>
          <li class="nav-item"><a class="nav-link <%= path.startsWith('/exercise') ? 'active' : '' %>" href="/exercise/start">Mulai Latihan</a></li>
          <li class="nav-item"><a class="nav-link <%= path.startsWith('/review') ? 'active' : '' %>" href="/review">Review</a></li>
          <li class="nav-item"><a class="nav-link <%= path.startsWith('/history') ? 'active' : '' %>" href="/history">Riwayat</a></li>
          <li class="nav-item"><a class="nav-link <%= path.startsWith('/music') ? 'active' : '' %>" href="/music">Musik</a></li>
        </ul>
        <form action="/logout" method="POST">
          <button class="btn btn-outline-danger btn-sm">Logout</button>
        </form>
      </div>
    </div>
  </nav>
<% } %>

<main class="container py-4 py-md-5">
  <% if (statusMessage) { %>
    <div class="alert alert-info"><%= statusMessage %></div>
  <% } %>
  <% if (exerciseMessage) { %>
    <div class="alert alert-success"><%= exerciseMessage %></div>
  <% } %>

  <%- body %>
</main>
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>
