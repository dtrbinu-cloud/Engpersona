<!doctype html>
<html lang="id">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Onboarding - EngPersona</title>
  <link rel="icon" type="image/jpeg" href="/wbicon.jpg">
  <link rel="stylesheet" href="/engpersona-ui.css">
</head>
<body>
  <main class="chat-screen">
    <img class="ep-logo-img side-logo" src="/logo.png" alt="EngPersona">

    <section class="chat-content">
      <div class="chat-bubble"><%= screen.question %></div>

      <% if (screen.type === 'level-grid' || screen.type === 'reason-grid') { %>
        <div class="option-grid">
          <% screen.options.forEach(function(option) { %>
            <form method="POST" action="/onboarding/<%= screen.type === 'level-grid' ? 'level' : 'reason' %>">
              <input type="hidden" name="value" value="<%= option.value %>">
              <button class="option-card <%= screen.type === 'level-grid' ? 'has-tag' : '' %>" type="submit">
              <span class="icon" aria-hidden="true"><%= option.icon %></span>
              <span class="label"><%= option.text %></span>
              </button>
            </form>
          <% }); %>
        </div>
      <% } %>

      <% if (screen.type === 'level-list') { %>
        <div class="level-list">
          <% screen.options.forEach(function(option) { %>
            <form method="POST" action="/onboarding/english-level">
            <input type="hidden" name="value" value="<%= option.value %>">
            <button class="level-row selectable-option" type="submit">
              <span class="tiny-icon" aria-hidden="true"><%= option.icon %></span>
              <span><%= option.text %></span>
            </button>
            </form>
          <% }); %>
        </div>
      <% } %>

      <% if (screen.type === 'start-list') { %>
        <div class="start-list">
          <% screen.options.forEach(function(option) { %>
            <form method="POST" action="/onboarding/start-point">
            <input type="hidden" name="value" value="<%= option.value %>">
            <button class="start-card selectable-option" type="submit">
              <span class="round-icon <%= option.iconClass %>" aria-hidden="true"><%= option.icon %></span>
              <span>
                <h2><%= option.title %></h2>
                <p><%= option.description %></p>
              </span>
            </button>
            </form>
          <% }); %>
        </div>
      <% } %>
    </section>

  </main>
  <script>
    document.querySelectorAll('.selectable-option').forEach(function(option) {
      option.addEventListener('click', function() {
        option.parentElement.querySelectorAll('.selectable-option').forEach(function(item) {
          item.classList.remove('selected');
        });
        option.classList.add('selected');
      });
    });
  </script>
</body>
</html>
