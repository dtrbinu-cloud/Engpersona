<!doctype html>
<html lang="id">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Profil - EngPersona</title>
  <link rel="icon" type="image/jpeg" href="/wbicon.jpg">
  <link rel="stylesheet" href="/engpersona-ui.css">
  <style>
    .profile-screen {
      min-height: 100vh;
      background: radial-gradient(circle at 88% 10%, #ffffff 0 22%, #eaf7ff 42%, #b5ddf7 100%);
      display: grid;
      place-items: center;
      padding: 40px 20px;
      position: relative;
    }

    .profile-screen .auth-corner-logo {
      position: absolute;
      top: 16px;
      left: 34px;
    }

    .profile-card {
      width: min(480px, calc(100vw - 40px));
      min-height: 520px;
      border-radius: 24px;
      background: linear-gradient(160deg, rgba(179, 195, 233, 0.92), rgba(93, 130, 245, 0.85));
      backdrop-filter: blur(12px);
      box-shadow: 0 20px 50px rgba(27, 42, 107, 0.22);
      padding: 36px 32px 40px;
      display: flex;
      flex-direction: column;
      align-items: center;
      gap: 28px;
    }

    .profile-card .brand-title {
      color: #2a4ce0;
      font-size: 28px;
      font-weight: 900;
      letter-spacing: 0.5px;
    }

    /* ── Avatar Carousel ── */
    .avatar-carousel {
      width: 100%;
      display: flex;
      justify-content: center;
      align-items: center;
      height: 180px;
      position: relative;
      overflow: visible;
    }

    .avatar-slot {
      position: absolute;
      cursor: pointer;
      transition: transform 0.55s cubic-bezier(0.34, 1.56, 0.64, 1),
                  opacity 0.45s ease,
                  z-index 0s;
      will-change: transform, opacity;
    }

    .avatar-ring {
      width: 120px;
      height: 120px;
      border-radius: 50%;
      overflow: hidden;
      border: 4px solid rgba(255, 255, 255, 0.45);
      box-shadow: 0 8px 24px rgba(27, 42, 107, 0.2);
      transition: width 0.45s cubic-bezier(0.34, 1.56, 0.64, 1),
                  height 0.45s cubic-bezier(0.34, 1.56, 0.64, 1),
                  border-color 0.4s ease,
                  box-shadow 0.4s ease;
      background: #e0e8f7;
    }

    .avatar-ring img {
      width: 100%;
      height: 100%;
      object-fit: cover;
      display: block;
    }

    .avatar-label {
      text-align: center;
      margin-top: 6px;
      font-size: 0;
      font-weight: 800;
      color: rgba(255, 255, 255, 0.9);
      opacity: 0;
      transition: opacity 0.4s ease, font-size 0.3s ease;
    }

    /* ── Pulse animation for selected avatar ── */
    @keyframes pulseRing {
      0% { box-shadow: 0 0 0 4px rgba(99, 132, 244, 0.45), 0 12px 32px rgba(27, 42, 107, 0.3); }
      50% { box-shadow: 0 0 0 8px rgba(99, 132, 244, 0.2), 0 12px 32px rgba(27, 42, 107, 0.3); }
      100% { box-shadow: 0 0 0 4px rgba(99, 132, 244, 0.45), 0 12px 32px rgba(27, 42, 107, 0.3); }
    }

    /* ── Hover effect for non-center items ── */
    .avatar-slot:not(.is-center):hover .avatar-ring {
      border-color: rgba(255, 255, 255, 0.85);
      box-shadow: 0 8px 28px rgba(27, 42, 107, 0.35);
    }

    /* ── Form ── */
    .profile-form {
      width: min(300px, 100%);
      display: flex;
      flex-direction: column;
      align-items: center;
      gap: 6px;
    }

    .profile-input {
      width: 100%;
      height: 50px;
      border: 0;
      border-radius: 14px;
      background: rgba(233, 238, 252, 0.92);
      color: #6282f2;
      padding: 0 18px;
      font-size: 16px;
      font-weight: 800;
      box-shadow: 0 5px 12px rgba(27, 42, 107, 0.18);
      outline: none;
      transition: box-shadow 0.3s ease;
    }

    .profile-input:focus {
      box-shadow: 0 5px 18px rgba(99, 132, 244, 0.35);
    }

    .profile-input::placeholder {
      color: #6282f2;
      opacity: 0.7;
    }

    .email-hint {
      font-size: 13px;
      font-weight: 700;
      color: rgba(255, 255, 255, 0.7);
      margin-top: 2px;
      align-self: flex-start;
      padding-left: 8px;
    }

    .profile-submit {
      width: min(260px, 100%);
      height: 52px;
      border: 0;
      border-radius: 14px;
      background: rgba(233, 238, 252, 0.92);
      color: #6384f4;
      font-size: 18px;
      font-weight: 900;
      box-shadow: 0 5px 12px rgba(27, 42, 107, 0.22);
      cursor: pointer;
      transition: transform 0.25s ease, box-shadow 0.25s ease;
      margin-top: 12px;
    }

    .profile-submit:hover {
      transform: translateY(-2px);
      box-shadow: 0 8px 20px rgba(27, 42, 107, 0.3);
    }

    .profile-submit:active {
      transform: translateY(0);
    }

    .hidden-input {
      display: none;
    }

    /* ── Form validation error ── */
    .profile-error {
      width: min(300px, 100%);
      border-radius: 12px;
      padding: 10px 14px;
      background: rgba(255, 255, 255, 0.24);
      color: #fff;
      font-size: 13px;
      font-weight: 700;
      text-align: center;
    }

    /* ── Responsive ── */
    @media (max-width: 520px) {
      .profile-card {
        padding: 28px 20px 32px;
      }

      .profile-screen .auth-corner-logo {
        top: 14px;
        left: 14px;
      }
    }
  </style>
</head>
<body>
  <main class="profile-screen">
    <img class="ep-logo-img auth-corner-logo" src="/logo.png" alt="EngPersona">

    <div class="profile-card">
      <div class="brand-title">EngPersona</div>

      <% if (typeof formError !== 'undefined' && formError) { %>
        <div class="profile-error"><%= formError %></div>
      <% } %>

      <div class="avatar-carousel" id="avatarCarousel">
        <div class="avatar-slot" data-index="0" data-avatar="icon3.jpg">
          <div class="avatar-ring">
            <img src="/icon3.jpg" alt="Avatar 1" draggable="false">
          </div>
          <div class="avatar-label">Avatar 1</div>
        </div>
        <div class="avatar-slot" data-index="1" data-avatar="icon1.jpg">
          <div class="avatar-ring">
            <img src="/icon1.jpg" alt="Avatar 2" draggable="false">
          </div>
          <div class="avatar-label">Avatar 2</div>
        </div>
        <div class="avatar-slot" data-index="2" data-avatar="icon2.jpg">
          <div class="avatar-ring">
            <img src="/icon2.jpg" alt="Avatar 3" draggable="false">
          </div>
          <div class="avatar-label">Avatar 3</div>
        </div>
      </div>

      <form action="/profile-setup" method="POST" class="profile-form" id="profileForm">
        <input type="hidden" name="avatar" id="avatarInput" value="icon1.jpg">
        <input
          class="profile-input"
          type="text"
          name="display_name"
          value="<%= typeof oldInput !== 'undefined' ? (oldInput.display_name || '') : '' %>"
          placeholder="buat nama"
          required
          maxlength="50"
          autocomplete="off">
        <div class="email-hint"><%= username %></div>
        <button class="profile-submit" type="submit">Lanjut</button>
      </form>
    </div>
  </main>

  <script>
    (function() {
      const slots = Array.from(document.querySelectorAll('.avatar-slot'));
      const avatarInput = document.getElementById('avatarInput');
      const TOTAL = slots.length; // 3
      let centerIndex = 1; // start with middle avatar as center

      // Layout config
      const CENTER_SCALE = 1;
      const SIDE_SCALE = 0.72;
      const FAR_SCALE = 0.58;
      const SIDE_OFFSET = 150;   // px from center for adjacent item
      const FAR_OFFSET = 195;    // px from center for far item (when 2 items on same side)

      const CENTER_RING = 140;   // px diameter for center avatar
      const SIDE_RING = 110;     // px diameter for side avatars

      function applyLayout(animate) {
        slots.forEach((slot, i) => {
          const diff = i - centerIndex;

          // Remove old class
          slot.classList.remove('is-center');

          if (animate) {
            slot.style.transition = 'transform 0.55s cubic-bezier(0.34, 1.56, 0.64, 1), opacity 0.45s ease';
          } else {
            slot.style.transition = 'none';
          }

          const ring = slot.querySelector('.avatar-ring');
          const label = slot.querySelector('.avatar-label');

          if (diff === 0) {
            // Center item
            slot.classList.add('is-center');
            slot.style.transform = `scale(${CENTER_SCALE}) translateX(0px)`;
            slot.style.zIndex = '10';
            slot.style.opacity = '1';
            ring.style.width = CENTER_RING + 'px';
            ring.style.height = CENTER_RING + 'px';
            ring.style.borderColor = '#fff';
            ring.style.animation = 'pulseRing 2.4s ease-in-out infinite';
            label.style.opacity = '1';
            label.style.fontSize = '13px';
          } else {
            // Non-center items
            let offset, scale, zIdx, opacity;

            if (Math.abs(diff) === 1) {
              // Direct neighbor
              offset = diff < 0 ? -SIDE_OFFSET : SIDE_OFFSET;
              scale = SIDE_SCALE;
              zIdx = '5';
              opacity = '1';
            } else {
              // Far item (diff is ±2)
              offset = diff < 0 ? -FAR_OFFSET : FAR_OFFSET;
              scale = FAR_SCALE;
              zIdx = '2';
              opacity = '0.65';
            }

            slot.style.transform = `scale(${scale}) translateX(${offset}px)`;
            slot.style.zIndex = zIdx;
            slot.style.opacity = opacity;
            ring.style.width = SIDE_RING + 'px';
            ring.style.height = SIDE_RING + 'px';
            ring.style.borderColor = 'rgba(255, 255, 255, 0.45)';
            ring.style.animation = 'none';
            label.style.opacity = '0';
            label.style.fontSize = '0';
          }
        });
      }

      // Click handler
      slots.forEach((slot, i) => {
        slot.addEventListener('click', () => {
          if (i === centerIndex) return;
          centerIndex = i;
          avatarInput.value = slot.dataset.avatar;
          applyLayout(true);
        });
      });

      // Initial layout (no animation)
      applyLayout(false);
      // Force reflow then enable transitions
      void document.body.offsetHeight;
    })();
  </script>
</body>
</html>
