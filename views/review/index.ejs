<!doctype html>
<html lang="id">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Profil Akun – EngPersona</title>
  <meta name="description" content="Halaman pengaturan profil akun pengguna EngPersona.">
  <link rel="stylesheet" href="/engpersona-ui.css">
  <style>
    :root {
      --bg-dark-panel: #0a223c;
      --bg-gradient: linear-gradient(135deg, #5086ec, #2b5bc3);
      --text-white: #ffffff;
      --btn-bg: #dbe3ed;
      --btn-text: #3c5473;
      --btn-active-bg: #eef3ff;
      --btn-active-text: #2a5cc0;
      --blue-panel: #1e55b8;
      --navy-header: #12335f;
      --red-delete: #dc2626;
      --blue-pill: #3f7de8;
      --green-save: #10b981;
    }

    * {
      box-sizing: border-box;
      margin: 0;
      padding: 0;
    }

    body {
      font-family: "Nunito", "Poppins", "Segoe UI", system-ui, -apple-system, sans-serif;
      background: var(--bg-gradient);
      min-height: 100vh;
      color: var(--text-white);
      overflow-x: hidden;
      padding: 20px;
      display: flex;
      justify-content: center;
    }

    /* ── Main Layout Container (Matches Dashboard) ── */
    .pg {
      display: grid;
      grid-template-columns: 280px 1fr;
      gap: 20px;
      width: 100%;
      max-width: 1600px;
      min-height: calc(100vh - 40px);
      margin: 0 auto;
    }

    /* ── Left Sidebar ── */
    .sidebar {
      background: var(--bg-dark-panel);
      border-radius: 24px;
      padding: 30px 24px;
      display: flex;
      flex-direction: column;
      height: calc(100vh - 40px);
      position: sticky;
      top: 20px;
      box-shadow: 0 15px 35px rgba(10, 34, 60, 0.25);
    }

    .sidebar-logo-container {
      display: flex;
      flex-direction: column;
      align-items: center;
      margin-bottom: 40px;
    }

    .sidebar-logo-container img {
      width: 100px;
      height: auto;
      margin-bottom: 8px;
    }

    .sidebar-brand-name {
      font-size: 24px;
      font-weight: 900;
      color: var(--text-white);
      letter-spacing: 0.5px;
    }

    .sidebar-menu {
      display: flex;
      flex-direction: column;
      gap: 12px;
      flex-grow: 1;
    }

    .menu-item {
      display: flex;
      align-items: center;
      padding: 14px 20px;
      background: var(--btn-bg);
      color: var(--btn-text);
      border-radius: 16px;
      font-size: 17px;
      font-weight: 800;
      transition: all 0.3s ease;
      border: none;
      cursor: pointer;
      width: 100%;
      text-align: left;
      text-decoration: none;
    }

    .menu-item:hover {
      transform: translateY(-2px);
      background: #e6edf7;
    }

    .menu-item.active {
      background: var(--btn-active-bg);
      color: var(--btn-active-text);
      box-shadow: 0 8px 20px rgba(255, 255, 255, 0.15);
    }

    /* ── Main Card (Enlarged Profile View) ── */
    .main-card {
      display: flex;
      border-radius: 24px;
      overflow: hidden;
      box-shadow: 0 15px 35px rgba(10, 34, 60, 0.25);
      height: calc(100vh - 40px);
      animation: fadeUp 0.45s ease both;
    }

    /* Left panel inside main card (Profile Summary) */
    .profile-panel {
      width: 320px;
      flex-shrink: 0;
      background: var(--bg-dark-panel);
      display: flex;
      flex-direction: column;
      align-items: center;
      padding: 3.5rem 2rem 2rem;
    }

    .pp-avatar {
      width: 130px;
      height: 130px;
      border-radius: 50%;
      border: 4px solid var(--text-white);
      object-fit: cover;
      background: var(--navy-header);
      display: flex;
      align-items: center;
      justify-content: center;
      font-size: 3rem;
      font-weight: 900;
      color: var(--text-white);
      overflow: hidden;
      flex-shrink: 0;
      box-shadow: 0 8px 25px rgba(0,0,0,0.35);
      margin-bottom: 1.5rem;
    }

    .pp-avatar img {
      width: 100%;
      height: 100%;
      object-fit: cover;
      border-radius: 50%;
    }

    .pp-email {
      color: rgba(255, 255, 255, 0.7);
      font-size: 0.95rem;
      font-weight: 600;
      margin-bottom: 0.5rem;
      text-align: center;
      word-break: break-all;
    }

    .pp-name {
      color: var(--text-white);
      font-size: 1.4rem;
      font-weight: 800;
      text-align: center;
    }

    .pp-spacer {
      flex: 1;
    }

    .card-logout-btn {
      width: 100%;
      height: 48px;
      background: #000000;
      color: var(--text-white);
      border: none;
      border-radius: 24px;
      font-size: 16px;
      font-weight: 800;
      cursor: pointer;
      transition: all 0.3s ease;
    }

    .card-logout-btn:hover {
      background: #222222;
      transform: translateY(-2px);
      box-shadow: 0 8px 15px rgba(0, 0, 0, 0.2);
    }

    /* Right panel inside main card (Account Detail) */
    .detail-panel {
      flex: 1;
      background: var(--blue-panel);
      display: flex;
      flex-direction: column;
    }

    .dp-header {
      background: var(--navy-header);
      padding: 2.5rem 2rem 2rem;
      display: flex;
      align-items: center;
      justify-content: center;
      position: relative;
    }

    .dp-avatar-wrap {
      position: relative;
      display: inline-block;
    }

    .dp-avatar {
      width: 135px;
      height: 135px;
      border-radius: 50%;
      border: 4px solid var(--text-white);
      object-fit: cover;
      background: var(--bg-dark-panel);
      display: flex;
      align-items: center;
      justify-content: center;
      font-size: 3.2rem;
      font-weight: 900;
      color: var(--text-white);
      overflow: hidden;
      box-shadow: 0 8px 25px rgba(0,0,0,0.35);
    }

    .dp-avatar img {
      width: 100%;
      height: 100%;
      object-fit: cover;
      border-radius: 50%;
    }

    .dp-edit-photo {
      position: absolute;
      bottom: 6px;
      right: 6px;
      width: 34px;
      height: 34px;
      background: #111827;
      border: 2px solid var(--text-white);
      border-radius: 50%;
      display: flex;
      align-items: center;
      justify-content: center;
      font-size: 0.85rem;
      color: var(--text-white);
      cursor: pointer;
      transition: all 0.2s ease;
    }

    .dp-edit-photo:hover {
      background: #2563eb;
      transform: scale(1.1);
    }

    .dp-dots {
      position: absolute;
      top: 1.2rem;
      right: 1.5rem;
      background: transparent;
      border: none;
      color: var(--text-white);
      font-size: 1.6rem;
      cursor: pointer;
      padding: 0.25rem 0.5rem;
      border-radius: 0.4rem;
      letter-spacing: 2px;
      line-height: 1;
      font-weight: 900;
      transition: background 0.2s;
    }

    .dp-dots:hover {
      background: rgba(255, 255, 255, 0.15);
    }

    /* Content area */
    .dp-content {
      flex: 1;
      padding: 2.5rem 3rem;
      display: flex;
      flex-direction: column;
      gap: 2rem;
      overflow-y: auto;
    }

    .toast-banner {
      padding: 0.8rem 1.2rem;
      border-radius: 12px;
      font-size: 0.95rem;
      font-weight: 700;
      margin-bottom: 1rem;
      display: none;
      animation: fadeUp 0.3s ease;
    }

    .toast-banner.success {
      background: #10b981;
      color: #ffffff;
      box-shadow: 0 4px 15px rgba(16, 185, 129, 0.3);
    }

    .toast-banner.error {
      background: #ef4444;
      color: #ffffff;
      box-shadow: 0 4px 15px rgba(239, 68, 68, 0.3);
    }

    .info-block {
      display: flex;
      flex-direction: column;
      gap: 1rem;
    }

    .info-title {
      color: var(--text-white);
      font-size: 1.25rem;
      font-weight: 800;
      margin-bottom: 0.2rem;
    }

    .info-row {
      display: flex;
      align-items: center;
      gap: 1rem;
      flex-wrap: wrap;
    }

    .info-label {
      color: var(--text-white);
      font-size: 1.05rem;
      font-weight: 700;
      width: 120px;
      flex-shrink: 0;
    }

    .info-value {
      color: rgba(255, 255, 255, 0.9);
      font-size: 1.05rem;
      font-weight: 500;
      flex: 1;
    }

    .edit-btn {
      background: var(--blue-pill);
      color: var(--text-white);
      border: none;
      border-radius: 9999px;
      padding: 0.4rem 1.25rem;
      font-size: 0.85rem;
      font-weight: 800;
      cursor: pointer;
      font-family: inherit;
      flex-shrink: 0;
      transition: all 0.2s ease;
    }

    .edit-btn:hover {
      background: #2563eb;
      transform: translateY(-1px);
    }

    .save-btn {
      background: var(--green-save);
      color: var(--text-white);
      border: none;
      border-radius: 9999px;
      padding: 0.45rem 1.35rem;
      font-size: 0.88rem;
      font-weight: 800;
      cursor: pointer;
      font-family: inherit;
      flex-shrink: 0;
      transition: all 0.2s ease;
      box-shadow: 0 4px 12px rgba(16, 185, 129, 0.35);
    }

    .save-btn:hover {
      background: #059669;
      transform: translateY(-1px);
    }

    .cancel-btn {
      background: rgba(255, 255, 255, 0.2);
      color: var(--text-white);
      border: none;
      border-radius: 9999px;
      padding: 0.45rem 1rem;
      font-size: 0.85rem;
      font-weight: 700;
      cursor: pointer;
      font-family: inherit;
      flex-shrink: 0;
      transition: all 0.2s ease;
    }

    .cancel-btn:hover {
      background: rgba(255, 255, 255, 0.35);
    }

    .edit-input {
      background: rgba(255, 255, 255, 0.15);
      border: 2px solid rgba(255, 255, 255, 0.4);
      border-radius: 10px;
      color: var(--text-white);
      padding: 0.45rem 0.85rem;
      font-size: 1rem;
      font-weight: 600;
      outline: none;
      flex: 1;
      min-width: 200px;
      font-family: inherit;
      transition: all 0.2s ease;
    }

    .edit-input:focus {
      border-color: #ffffff;
      background: rgba(255, 255, 255, 0.25);
      box-shadow: 0 0 10px rgba(255, 255, 255, 0.3);
    }

    .divider {
      height: 1px;
      background: rgba(255, 255, 255, 0.18);
      border: none;
    }

    /* Delete zone */
    .dp-footer {
      padding: 1.5rem 3rem 2rem;
      display: flex;
      justify-content: flex-end;
    }

    .delete-btn {
      background: var(--red-delete);
      color: var(--text-white);
      border: none;
      border-radius: 10px;
      padding: 0.75rem 1.75rem;
      font-size: 0.88rem;
      font-weight: 900;
      letter-spacing: 0.05em;
      cursor: pointer;
      font-family: inherit;
      transition: all 0.2s ease;
    }

    .delete-btn:hover {
      background: #b91c1c;
      transform: translateY(-2px);
      box-shadow: 0 6px 20px rgba(220, 38, 38, 0.45);
    }

    /* Initials fallback */
    .avatar-initials {
      width: 100%;
      height: 100%;
      display: flex;
      align-items: center;
      justify-content: center;
      font-size: inherit;
      font-weight: 900;
      color: var(--text-white);
      background: var(--navy-header);
      border-radius: 50%;
    }

    /* Modals */
    .modal-overlay {
      position: fixed;
      top: 0; left: 0; right: 0; bottom: 0;
      background: rgba(0, 0, 0, 0.65);
      backdrop-filter: blur(6px);
      z-index: 999;
      display: flex;
      align-items: center;
      justify-content: center;
      padding: 20px;
    }

    .modal-card {
      background: var(--bg-dark-panel);
      border-radius: 24px;
      width: 100%;
      max-width: 450px;
      padding: 2rem;
      box-shadow: 0 25px 50px rgba(0,0,0,0.5);
      display: flex;
      flex-direction: column;
      gap: 1.25rem;
      border: 1px solid rgba(255, 255, 255, 0.15);
      animation: fadeUp 0.3s ease;
    }

    .modal-title {
      font-size: 1.35rem;
      font-weight: 900;
      color: var(--text-white);
      text-align: center;
    }

    .avatar-grid {
      display: flex;
      justify-content: center;
      gap: 1.25rem;
      margin: 1rem 0;
    }

    .avatar-option {
      width: 85px;
      height: 85px;
      border-radius: 50%;
      border: 4px solid transparent;
      cursor: pointer;
      transition: all 0.25s ease;
      object-fit: cover;
    }

    .avatar-option:hover, .avatar-option.selected {
      border-color: #3b82f6;
      transform: scale(1.1);
      box-shadow: 0 6px 20px rgba(59, 130, 246, 0.5);
    }

    .modal-actions {
      display: flex;
      gap: 10px;
      justify-content: flex-end;
      margin-top: 0.5rem;
    }

    .hidden {
      display: none !important;
    }

    @keyframes fadeUp {
      from { opacity: 0; transform: translateY(15px); }
      to   { opacity: 1; transform: translateY(0); }
    }

    /* Responsive adjustments */
    @media (max-width: 1120px) {
      .pg {
        grid-template-columns: 1fr;
        min-height: auto;
      }
      .sidebar {
        height: auto;
        position: static;
      }
      .main-card {
        flex-direction: column;
        height: auto;
      }
      .profile-panel {
        width: 100%;
        padding: 2rem;
      }
    }
  </style>
</head>
<body>

<%
  /* ── Helpers ── */
  const uName    = user.username || 'nama_user';
  const uEmail   = user.email || user.username || 'email_user';
  const initials = String(uName).charAt(0).toUpperCase();
  const avatarSrc = user.avatar ? '/' + user.avatar.replace(/^\//, '') : null;
%>

<div class="pg">

  <!-- ══════════════════
       LEFT SIDEBAR
  ══════════════════ -->
  <aside class="sidebar" role="navigation" aria-label="Menu utama">

    <div class="sidebar-logo-container">
      <img src="/logo.png" alt="EngPersona Logo">
      <div class="sidebar-brand-name">engpersona</div>
    </div>

    <nav class="sidebar-menu">
      <a href="/dashboard" class="menu-item" id="nav-home">Home</a>
      <a href="/exercise/start" class="menu-item" id="nav-belajar">Belajar</a>
      <a href="/history" class="menu-item" id="nav-score">Score</a>
      <a href="/review" class="menu-item active" id="nav-profil" aria-current="page">Profil</a>
    </nav>

  </aside><!-- /sidebar -->

  <!-- ══════════════════
       MAIN CARD
  ══════════════════ -->
  <main class="main-card">

    <!-- LEFT PANEL: Profile Summary -->
    <section class="profile-panel" aria-label="Ringkasan profil">

      <div class="pp-avatar" id="pp-avatar-sm" aria-label="Foto profil">
        <% if (avatarSrc) { %>
          <img src="<%= avatarSrc %>" alt="Avatar <%= uName %>" class="avatar-img-element">
        <% } else { %>
          <div class="avatar-initials"><%= initials %></div>
        <% } %>
      </div>

      <p class="pp-email" id="side-disp-email"><%= uEmail %></p>
      <h2 class="pp-name" id="side-disp-name"><%= uName %></h2>

      <div class="pp-spacer"></div>

      <form action="/logout" method="POST" style="width: 100%;">
        <button type="submit" class="card-logout-btn" id="btn-logout-card">Log-out</button>
      </form>

    </section><!-- /profile-panel -->

    <!-- RIGHT PANEL: Account Detail -->
    <section class="detail-panel" aria-label="Detail akun">

      <!-- Header avatar -->
      <div class="dp-header">
        <div class="dp-avatar-wrap">
          <div class="dp-avatar" id="dp-avatar-lg" aria-label="Foto profil besar">
            <% if (avatarSrc) { %>
              <img src="<%= avatarSrc %>" alt="Avatar" class="avatar-img-element">
            <% } else { %>
              <div class="avatar-initials"><%= initials %></div>
            <% } %>
          </div>
          <button class="dp-edit-photo" id="btn-edit-photo" title="Edit foto profil" aria-label="Edit foto profil">✏️</button>
        </div>
        <button class="dp-dots" id="btn-menu-dots" title="Opsi lain" aria-label="Menu opsi">···</button>
      </div>

      <!-- Info fields -->
      <div class="dp-content">

        <!-- Notification Banner -->
        <div id="toast-banner" class="toast-banner"></div>

        <!-- Akun Info -->
        <div class="info-block" aria-labelledby="sec-akun">
          <p class="info-title" id="sec-akun">Akun Info</p>

          <!-- Username Row -->
          <div class="info-row">
            <span class="info-label">Username</span>
            <span class="info-value" id="disp-username"><%= uName %></span>
            <div id="wrapper-edit-username" class="hidden" style="display: flex; gap: 8px; flex: 1; align-items: center;">
              <input type="text" id="input-username" class="edit-input" value="<%= uName %>">
              <button class="save-btn" id="btn-save-username">Simpan</button>
              <button class="cancel-btn" id="btn-cancel-username">Batal</button>
            </div>
            <button class="edit-btn" id="btn-edit-username" aria-label="Edit username">edit</button>
          </div>

          <hr class="divider">

          <!-- Email Row -->
          <div class="info-row">
            <span class="info-label">Email</span>
            <span class="info-value" id="disp-email"><%= uEmail %></span>
            <div id="wrapper-edit-email" class="hidden" style="display: flex; gap: 8px; flex: 1; align-items: center;">
              <input type="email" id="input-email" class="edit-input" value="<%= uEmail %>">
              <button class="save-btn" id="btn-save-email">Simpan</button>
              <button class="cancel-btn" id="btn-cancel-email">Batal</button>
            </div>
            <button class="edit-btn" id="btn-edit-email" aria-label="Edit email">edit</button>
          </div>
        </div>

        <!-- Password -->
        <div class="info-block" aria-labelledby="sec-pw">
          <p class="info-title" id="sec-pw">Password</p>
          <div class="info-row">
            <span class="info-label">Password</span>
            <span class="info-value" id="disp-pw">••••••••</span>
            <button class="edit-btn" id="btn-edit-pw" aria-label="Edit password">edit</button>
          </div>
        </div>

      </div><!-- /dp-content -->

      <!-- Delete button -->
      <div class="dp-footer">
        <button class="delete-btn" id="btn-hapus" aria-label="Hapus akun">HAPUS AKUN</button>
      </div>

    </section><!-- /detail-panel -->

  </main><!-- /main-card -->

</div><!-- /pg -->

<!-- ══════════════════
     MODAL EDIT FOTO PROFIL
══════════════════ -->
<div id="modal-photo" class="modal-overlay hidden">
  <div class="modal-card">
    <h3 class="modal-title">Pilih Foto Profil Baru</h3>
    <div class="avatar-grid">
      <img src="/icon1.jpg" alt="Icon 1" class="avatar-option" data-avatar="icon1.jpg">
      <img src="/icon2.jpg" alt="Icon 2" class="avatar-option" data-avatar="icon2.jpg">
      <img src="/icon3.jpg" alt="Icon 3" class="avatar-option" data-avatar="icon3.jpg">
    </div>
    <div class="modal-actions">
      <button class="cancel-btn" id="btn-close-modal-photo">Batal</button>
      <button class="save-btn" id="btn-save-photo">Simpan Foto</button>
    </div>
  </div>
</div>

<!-- ══════════════════
     MODAL EDIT PASSWORD (Perlu konfirmasi password lama)
══════════════════ -->
<div id="modal-pw" class="modal-overlay hidden">
  <div class="modal-card">
    <h3 class="modal-title">Ganti Password</h3>
    
    <div style="display: flex; flex-direction: column; gap: 6px;">
      <label style="font-size: 0.9rem; font-weight: 700;">Password Saat Ini (Konfirmasi Lama):</label>
      <input type="password" id="input-curr-pw" class="edit-input" placeholder="Password lama untuk konfirmasi">
    </div>

    <div style="display: flex; flex-direction: column; gap: 6px;">
      <label style="font-size: 0.9rem; font-weight: 700;">Password Baru:</label>
      <input type="password" id="input-new-pw" class="edit-input" placeholder="Password baru (min 6 karakter)">
    </div>

    <div style="display: flex; flex-direction: column; gap: 6px;">
      <label style="font-size: 0.9rem; font-weight: 700;">Konfirmasi Password Baru:</label>
      <input type="password" id="input-conf-pw" class="edit-input" placeholder="Ulangi password baru">
    </div>

    <div class="modal-actions">
      <button class="cancel-btn" id="btn-close-modal-pw">Batal</button>
      <button class="save-btn" id="btn-save-pw">Simpan Password Baru</button>
    </div>
  </div>
</div>

<script>
  let currentAvatar = "<%= user.avatar || 'icon2.jpg' %>";
  let selectedAvatar = currentAvatar;

  function showToast(message, isSuccess = true) {
    const toast = document.getElementById('toast-banner');
    toast.textContent = message;
    toast.className = `toast-banner ${isSuccess ? 'success' : 'error'}`;
    toast.style.display = 'block';
    setTimeout(() => {
      toast.style.display = 'none';
    }, 4500);
  }

  // ── 1. EDIT USERNAME ──
  const btnEditUsername = document.getElementById('btn-edit-username');
  const btnSaveUsername = document.getElementById('btn-save-username');
  const btnCancelUsername = document.getElementById('btn-cancel-username');
  const dispUsername = document.getElementById('disp-username');
  const wrapperEditUsername = document.getElementById('wrapper-edit-username');
  const inputUsername = document.getElementById('input-username');
  const sideDispName = document.getElementById('side-disp-name');

  btnEditUsername.addEventListener('click', () => {
    dispUsername.classList.add('hidden');
    btnEditUsername.classList.add('hidden');
    wrapperEditUsername.classList.remove('hidden');
    inputUsername.focus();
  });

  btnCancelUsername.addEventListener('click', () => {
    wrapperEditUsername.classList.add('hidden');
    dispUsername.classList.remove('hidden');
    btnEditUsername.classList.remove('hidden');
  });

  btnSaveUsername.addEventListener('click', async () => {
    const val = inputUsername.value.trim();
    if (!val) return showToast('Username tidak boleh kosong!', false);

    try {
      const res = await fetch('/review/update-profile', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ username: val })
      });
      const data = await res.json();

      if (data.success) {
        dispUsername.textContent = val;
        sideDispName.textContent = val;
        wrapperEditUsername.classList.add('hidden');
        dispUsername.classList.remove('hidden');
        btnEditUsername.classList.remove('hidden');
        showToast(data.message, true);
      } else {
        showToast(data.message || 'Gagal menyimpan username.', false);
      }
    } catch (err) {
      showToast('Terjadi kesalahan jaringan.', false);
    }
  });

  // ── 2. EDIT EMAIL ──
  const btnEditEmail = document.getElementById('btn-edit-email');
  const btnSaveEmail = document.getElementById('btn-save-email');
  const btnCancelEmail = document.getElementById('btn-cancel-email');
  const dispEmail = document.getElementById('disp-email');
  const wrapperEditEmail = document.getElementById('wrapper-edit-email');
  const inputEmail = document.getElementById('input-email');
  const sideDispEmail = document.getElementById('side-disp-email');

  btnEditEmail.addEventListener('click', () => {
    dispEmail.classList.add('hidden');
    btnEditEmail.classList.add('hidden');
    wrapperEditEmail.classList.remove('hidden');
    inputEmail.focus();
  });

  btnCancelEmail.addEventListener('click', () => {
    wrapperEditEmail.classList.add('hidden');
    dispEmail.classList.remove('hidden');
    btnEditEmail.classList.remove('hidden');
  });

  btnSaveEmail.addEventListener('click', async () => {
    const val = inputEmail.value.trim();
    if (!val) return showToast('Email tidak boleh kosong!', false);

    try {
      const res = await fetch('/review/update-profile', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ email: val })
      });
      const data = await res.json();

      if (data.success) {
        dispEmail.textContent = val;
        sideDispEmail.textContent = val;
        wrapperEditEmail.classList.add('hidden');
        dispEmail.classList.remove('hidden');
        btnEditEmail.classList.remove('hidden');
        showToast(data.message, true);
      } else {
        showToast(data.message || 'Gagal menyimpan email.', false);
      }
    } catch (err) {
      showToast('Terjadi kesalahan jaringan.', false);
    }
  });

  // ── 3. EDIT FOTO PROFIL (MODAL) ──
  const modalPhoto = document.getElementById('modal-photo');
  const btnEditPhoto = document.getElementById('btn-edit-photo');
  const btnCloseModalPhoto = document.getElementById('btn-close-modal-photo');
  const btnSavePhoto = document.getElementById('btn-save-photo');
  const avatarOptions = document.querySelectorAll('.avatar-option');

  btnEditPhoto.addEventListener('click', () => {
    selectedAvatar = currentAvatar;
    avatarOptions.forEach(opt => {
      if (opt.dataset.avatar === currentAvatar) {
        opt.classList.add('selected');
      } else {
        opt.classList.remove('selected');
      }
    });
    modalPhoto.classList.remove('hidden');
  });

  btnCloseModalPhoto.addEventListener('click', () => {
    modalPhoto.classList.add('hidden');
  });

  avatarOptions.forEach(opt => {
    opt.addEventListener('click', () => {
      avatarOptions.forEach(o => o.classList.remove('selected'));
      opt.classList.add('selected');
      selectedAvatar = opt.dataset.avatar;
    });
  });

  btnSavePhoto.addEventListener('click', async () => {
    try {
      const res = await fetch('/review/update-profile', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ avatar: selectedAvatar })
      });
      const data = await res.json();

      if (data.success) {
        currentAvatar = selectedAvatar;
        const newSrc = '/' + selectedAvatar.replace(/^\//, '');
        
        // Update all profile avatar image elements
        document.querySelectorAll('.avatar-img-element').forEach(img => {
          img.src = newSrc;
        });

        modalPhoto.classList.add('hidden');
        showToast('Foto profil berhasil disimpan!', true);
      } else {
        showToast(data.message || 'Gagal menyimpan foto profil.', false);
      }
    } catch (err) {
      showToast('Terjadi kesalahan jaringan.', false);
    }
  });

  // ── 4. EDIT PASSWORD (MODAL DENGAN KONFIRMASI PASSWORD LAMA) ──
  const modalPw = document.getElementById('modal-pw');
  const btnEditPw = document.getElementById('btn-edit-pw');
  const btnCloseModalPw = document.getElementById('btn-close-modal-pw');
  const btnSavePw = document.getElementById('btn-save-pw');
  const inputCurrPw = document.getElementById('input-curr-pw');
  const inputNewPw = document.getElementById('input-new-pw');
  const inputConfPw = document.getElementById('input-conf-pw');

  btnEditPw.addEventListener('click', () => {
    inputCurrPw.value = '';
    inputNewPw.value = '';
    inputConfPw.value = '';
    modalPw.classList.remove('hidden');
    inputCurrPw.focus();
  });

  btnCloseModalPw.addEventListener('click', () => {
    modalPw.classList.add('hidden');
  });

  btnSavePw.addEventListener('click', async () => {
    const current_password = inputCurrPw.value;
    const new_password = inputNewPw.value;
    const confirm_password = inputConfPw.value;

    if (!current_password) {
      return showToast('Masukkan password saat ini (lama) untuk konfirmasi!', false);
    }
    if (!new_password || new_password.length < 6) {
      return showToast('Password baru minimal 6 karakter!', false);
    }
    if (new_password !== confirm_password) {
      return showToast('Konfirmasi password baru tidak sesuai!', false);
    }

    try {
      const res = await fetch('/review/update-password', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ current_password, new_password, confirm_password })
      });
      const data = await res.json();

      if (data.success) {
        modalPw.classList.add('hidden');
        showToast(data.message, true);
      } else {
        showToast(data.message || 'Password lama salah atau gagal disimpan.', false);
      }
    } catch (err) {
      showToast('Terjadi kesalahan jaringan.', false);
    }
  });

  /* ── Three-dot menu placeholder ── */
  document.getElementById('btn-menu-dots').addEventListener('click', function() {
    alert('Opsi tambahan: Bagikan profil, Laporkan masalah.');
  });

  /* ── Hapus akun ── */
  document.getElementById('btn-hapus').addEventListener('click', function() {
    if (confirm('⚠️ Hapus akun secara permanen?\nTindakan ini tidak dapat dibatalkan.')) {
      alert('Permintaan penghapusan akun dikirim.');
    }
  });
</script>

</body>
</html>
