<!doctype html>
<html lang="id">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Profil Akun – EngPersona</title>
  <meta name="description" content="Halaman pengaturan profil akun pengguna EngPersona.">
  <style>
    /* ══════════════════════════════════════
       RESET & BASE
    ══════════════════════════════════════ */
    *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }

    :root {
      --navy-darkest : #0b1835;
      --navy-dark    : #112250;
      --navy-mid     : #173882;
      --blue-panel   : #1e55b8;
      --blue-accent  : #3b82f6;
      --blue-pill    : #4a86e8;
      --white        : #ffffff;
      --gray-light   : #dde3ec;
      --gray-muted   : #94a3b8;
      --red-delete   : #dc2626;
      --black-logout : #0f0f0f;
      --radius-2xl   : 1.5rem;
      --radius-pill  : 9999px;
    }

    body {
      font-family: "Segoe UI", system-ui, -apple-system, sans-serif;
      min-height: 100vh;
      background: linear-gradient(135deg, var(--navy-darkest) 0%, var(--navy-mid) 55%, #3b79c9 100%);
      display: flex;
      align-items: center;
      justify-content: center;
      padding: 1.75rem;
    }

    /* ══════════════════════════════════════
       PAGE WRAPPER
    ══════════════════════════════════════ */
    .pg {
      display: flex;
      gap: 1.25rem;
      width: 100%;
      max-width: 980px;
      min-height: 570px;
    }

    /* ══════════════════════════════════════
       SIDEBAR
    ══════════════════════════════════════ */
    .sidebar {
      width: 240px;
      flex-shrink: 0;
      background: var(--navy-dark);
      border-radius: var(--radius-2xl);
      padding: 2rem 1.25rem;
      display: flex;
      flex-direction: column;
      gap: 1.75rem;
      box-shadow: 0 8px 40px rgba(0,0,0,0.4);
      animation: fadeUp 0.45s ease both;
    }

    /* Logo area */
    .sb-logo {
      display: flex;
      justify-content: center;
      align-items: center;
      padding-bottom: 0.25rem;
    }

    /* Double-heart SVG icon */
    .sb-logo svg { width: 54px; height: 54px; }

    /* Nav links */
    .sb-nav { display: flex; flex-direction: column; gap: 0.55rem; flex: 1; }

    .sb-link {
      display: flex;
      align-items: center;
      gap: 0.7rem;
      padding: 0.65rem 1.1rem;
      border-radius: var(--radius-pill);
      font-size: 0.93rem;
      font-weight: 700;
      text-decoration: none;
      cursor: pointer;
      transition: background 0.18s, transform 0.14s;
      user-select: none;
      color: #1e293b;
      background: var(--gray-light);
    }

    .sb-link:hover { background: #c8d4e3; transform: translateX(3px); }

    .sb-link.active {
      background: var(--blue-accent);
      color: var(--white);
      box-shadow: 0 4px 18px rgba(59,130,246,0.45);
    }

    .sb-link.active:hover { background: #2563eb; }

    .sb-icon { font-size: 0.95rem; width: 18px; text-align: center; }

    /* ══════════════════════════════════════
       MAIN CARD (center + right joined)
    ══════════════════════════════════════ */
    .main-card {
      flex: 1;
      display: flex;
      border-radius: var(--radius-2xl);
      overflow: hidden;
      box-shadow: 0 8px 48px rgba(0,0,0,0.35);
      animation: fadeUp 0.45s 0.1s ease both;
      min-height: 570px;
    }

    /* ── CENTER: profile summary ── */
    .profile-panel {
      width: 210px;
      flex-shrink: 0;
      background: var(--navy-dark);
      display: flex;
      flex-direction: column;
      align-items: center;
      padding: 2.25rem 1.4rem 1.75rem;
    }

    .pp-avatar {
      width: 96px;
      height: 96px;
      border-radius: 50%;
      border: 3px solid var(--white);
      object-fit: cover;
      background: var(--navy-mid);
      display: flex;
      align-items: center;
      justify-content: center;
      font-size: 2.2rem;
      font-weight: 800;
      color: var(--white);
      overflow: hidden;
      flex-shrink: 0;
      box-shadow: 0 4px 20px rgba(0,0,0,0.4);
      margin-bottom: 1rem;
    }

    .pp-avatar img {
      width: 100%;
      height: 100%;
      object-fit: cover;
      border-radius: 50%;
    }

    .pp-email {
      color: var(--gray-muted);
      font-size: 0.78rem;
      font-weight: 500;
      margin-bottom: 0.3rem;
      text-align: center;
      word-break: break-all;
    }

    .pp-name {
      color: var(--white);
      font-size: 1.1rem;
      font-weight: 700;
      text-align: center;
    }

    .pp-spacer { flex: 1; }

    .logout-btn {
      background: var(--black-logout);
      color: var(--white);
      border: none;
      border-radius: var(--radius-pill);
      padding: 0.65rem 2rem;
      font-size: 0.88rem;
      font-weight: 700;
      cursor: pointer;
      font-family: inherit;
      letter-spacing: 0.02em;
      transition: background 0.18s, transform 0.14s, box-shadow 0.18s;
    }

    .logout-btn:hover {
      background: #222;
      transform: translateY(-2px);
      box-shadow: 0 6px 20px rgba(0,0,0,0.55);
    }

    /* ── RIGHT: account detail ── */
    .detail-panel {
      flex: 1;
      background: var(--blue-panel);
      display: flex;
      flex-direction: column;
    }

    /* Header with big avatar */
    .dp-header {
      background: var(--navy-mid);
      padding: 1.75rem 1.5rem 1.4rem;
      display: flex;
      align-items: center;
      justify-content: center;
      position: relative;
    }

    .dp-avatar-wrap { position: relative; display: inline-block; }

    .dp-avatar {
      width: 108px;
      height: 108px;
      border-radius: 50%;
      border: 4px solid var(--white);
      object-fit: cover;
      background: var(--navy-dark);
      display: flex;
      align-items: center;
      justify-content: center;
      font-size: 2.6rem;
      font-weight: 800;
      color: var(--white);
      overflow: hidden;
      box-shadow: 0 4px 24px rgba(0,0,0,0.4);
    }

    .dp-avatar img { width: 100%; height: 100%; object-fit: cover; border-radius: 50%; }

    .dp-edit-photo {
      position: absolute;
      bottom: 5px;
      right: 5px;
      width: 28px;
      height: 28px;
      background: #111827;
      border: 2px solid var(--white);
      border-radius: 50%;
      display: flex;
      align-items: center;
      justify-content: center;
      font-size: 0.72rem;
      color: var(--white);
      cursor: pointer;
      transition: background 0.18s, transform 0.14s;
    }

    .dp-edit-photo:hover { background: var(--blue-accent); transform: scale(1.1); }

    .dp-dots {
      position: absolute;
      top: 0.9rem;
      right: 1.1rem;
      background: transparent;
      border: none;
      color: var(--white);
      font-size: 1.25rem;
      cursor: pointer;
      padding: 0.25rem 0.5rem;
      border-radius: 0.4rem;
      letter-spacing: 2px;
      line-height: 1;
      font-weight: 900;
      transition: background 0.18s;
    }

    .dp-dots:hover { background: rgba(255,255,255,0.13); }

    /* Content area */
    .dp-content {
      flex: 1;
      padding: 1.6rem 2rem;
      display: flex;
      flex-direction: column;
      gap: 1.5rem;
      overflow-y: auto;
    }

    .info-block { display: flex; flex-direction: column; gap: 0.75rem; }

    .info-title {
      color: var(--white);
      font-size: 1rem;
      font-weight: 700;
      margin-bottom: 0.15rem;
    }

    .info-row {
      display: flex;
      align-items: center;
      gap: 0.5rem;
    }

    .info-label {
      color: var(--white);
      font-size: 0.87rem;
      font-weight: 600;
      width: 82px;
      flex-shrink: 0;
    }

    .info-value {
      color: rgba(255,255,255,0.82);
      font-size: 0.87rem;
      font-weight: 400;
      flex: 1;
    }

    .edit-btn {
      background: var(--blue-pill);
      color: var(--white);
      border: none;
      border-radius: var(--radius-pill);
      padding: 0.28rem 0.8rem;
      font-size: 0.73rem;
      font-weight: 700;
      cursor: pointer;
      font-family: inherit;
      flex-shrink: 0;
      transition: background 0.18s, transform 0.13s;
    }

    .edit-btn:hover { background: var(--blue-accent); transform: translateY(-1px); }

    .divider {
      height: 1px;
      background: rgba(255,255,255,0.13);
      border: none;
    }

    /* Delete zone */
    .dp-footer {
      padding: 0.85rem 1.75rem 1.4rem;
      display: flex;
      justify-content: flex-end;
    }

    .delete-btn {
      background: var(--red-delete);
      color: var(--white);
      border: none;
      border-radius: 0.4rem;
      padding: 0.5rem 1.1rem;
      font-size: 0.76rem;
      font-weight: 800;
      letter-spacing: 0.07em;
      cursor: pointer;
      font-family: inherit;
      transition: background 0.18s, transform 0.13s, box-shadow 0.18s;
    }

    .delete-btn:hover {
      background: #b91c1c;
      transform: translateY(-2px);
      box-shadow: 0 4px 18px rgba(220,38,38,0.5);
    }

    /* ══════════════════════════════════════
       AVATAR FALLBACK (initials)
    ══════════════════════════════════════ */
    .avatar-initials {
      width: 100%;
      height: 100%;
      display: flex;
      align-items: center;
      justify-content: center;
      font-size: inherit;
      font-weight: 800;
      color: var(--white);
      background: var(--navy-mid);
      border-radius: 50%;
    }

    /* ══════════════════════════════════════
       ANIMATION
    ══════════════════════════════════════ */
    @keyframes fadeUp {
      from { opacity: 0; transform: translateY(20px); }
      to   { opacity: 1; transform: translateY(0); }
    }

    /* ══════════════════════════════════════
       RESPONSIVE
    ══════════════════════════════════════ */
    @media (max-width: 820px) {
      body { padding: 1rem; }
      .pg { flex-direction: column; max-width: 100%; min-height: auto; }
      .sidebar { width: 100%; flex-direction: row; flex-wrap: wrap; padding: 1rem 1.25rem; gap: 0.75rem; }
      .sb-logo { padding-bottom: 0; }
      .sb-logo svg { width: 38px; height: 38px; }
      .sb-nav { flex-direction: row; flex-wrap: wrap; gap: 0.45rem; }
      .main-card { flex-direction: column; min-height: auto; }
      .profile-panel { width: 100%; flex-direction: row; padding: 1.25rem 1.5rem; gap: 1.25rem; align-items: center; }
      .pp-spacer { display: none; }
      .pp-avatar { width: 68px; height: 68px; font-size: 1.6rem; margin-bottom: 0; }
      .dp-header { padding: 1.25rem 1rem 1rem; }
    }
  </style>
</head>
<body>

<%
  /* ── Helpers ── */
  const uName    = user.username || 'nama_user';
  const uEmail   = user.username || 'email_user';
  const initials = String(uName).charAt(0).toUpperCase();
  const avatarSrc = user.avatar || null;
%>

<div class="pg">

  <!-- ══════════════════
       SIDEBAR
  ══════════════════ -->
  <aside class="sidebar" role="navigation" aria-label="Menu utama">

    <div class="sb-logo">
      <!-- Double-heart logo (inline SVG, no external deps) -->
      <svg viewBox="0 0 54 54" fill="none" xmlns="http://www.w3.org/2000/svg" aria-label="EngPersona">
        <!-- back heart (lighter) -->
        <path d="M10 21c0-4.418 3.358-7 6.5-7 1.986 0 3.77.91 5 2.34C22.73 14.91 24.514 14 26.5 14c3.142 0 6.5 2.582 6.5 7 0 4.418-3.358 8-6.5 8a6.98 6.98 0 01-4-1.26A6.98 6.98 0 0116.5 29C13.358 29 10 25.418 10 21z" fill="white" opacity="0.55"/>
        <!-- front heart -->
        <path d="M18 30c0-4.418 3.358-7 6.5-7 1.986 0 3.77.91 5 2.34C30.73 23.91 32.514 23 34.5 23c3.142 0 6.5 2.582 6.5 7 0 4.418-3.358 8-6.5 8a6.98 6.98 0 01-4-1.26A6.98 6.98 0 0124.5 38C21.358 38 18 34.418 18 30z" fill="white"/>
      </svg>
    </div>

    <nav class="sb-nav">
      <a href="/dashboard" class="sb-link" id="nav-home">
        <span class="sb-icon">🏠</span> Home
      </a>
      <a href="/exercise/start" class="sb-link" id="nav-belajar">
        <span class="sb-icon">📚</span> Belajar
      </a>
      <a href="/history" class="sb-link" id="nav-score">
        <span class="sb-icon">⭐</span> Score
      </a>
      <a href="/review" class="sb-link active" id="nav-profil" aria-current="page">
        <span class="sb-icon">👤</span> Profil
      </a>
    </nav>

  </aside><!-- /sidebar -->

  <!-- ══════════════════
       MAIN CARD
  ══════════════════ -->
  <div class="main-card" role="main">

    <!-- CENTER: profile summary -->
    <section class="profile-panel" aria-label="Ringkasan profil">

      <div class="pp-avatar" id="pp-avatar-sm" aria-label="Foto profil">
        <% if (avatarSrc) { %>
          <img src="<%= avatarSrc %>" alt="Avatar <%= uName %>">
        <% } else { %>
          <div class="avatar-initials"><%= initials %></div>
        <% } %>
      </div>

      <p class="pp-email"><%= uEmail %></p>
      <h2 class="pp-name"><%= uName %></h2>

      <div class="pp-spacer"></div>

      <form action="/logout" method="POST">
        <button type="submit" class="logout-btn" id="btn-logout">Log-out</button>
      </form>

    </section><!-- /profile-panel -->

    <!-- RIGHT: account detail -->
    <section class="detail-panel" aria-label="Detail akun">

      <!-- Header avatar -->
      <div class="dp-header">
        <div class="dp-avatar-wrap">
          <div class="dp-avatar" aria-label="Foto profil besar">
            <% if (avatarSrc) { %>
              <img src="<%= avatarSrc %>" alt="Avatar">
            <% } else { %>
              <div class="avatar-initials"><%= initials %></div>
            <% } %>
          </div>
          <button class="dp-edit-photo" id="btn-edit-photo" title="Edit foto" aria-label="Edit foto profil">✏️</button>
        </div>
        <button class="dp-dots" id="btn-menu-dots" title="Opsi lain" aria-label="Menu opsi">···</button>
      </div>

      <!-- Info fields -->
      <div class="dp-content">

        <!-- Akun Info -->
        <div class="info-block" aria-labelledby="sec-akun">
          <p class="info-title" id="sec-akun">Akun Info</p>

          <div class="info-row">
            <span class="info-label">Username</span>
            <span class="info-value" id="disp-username"><%= uName %></span>
            <button class="edit-btn" id="btn-edit-username" aria-label="Edit username">edit</button>
          </div>

          <hr class="divider">

          <div class="info-row">
            <span class="info-label">Email</span>
            <span class="info-value" id="disp-email"><%= user.username || 'email_user' %></span>
            <button class="edit-btn" id="btn-edit-email" aria-label="Edit email">edit</button>
          </div>
        </div>

        <!-- Password -->
        <div class="info-block" aria-labelledby="sec-pw">
          <p class="info-title" id="sec-pw">Password</p>
          <div class="info-row">
            <span class="info-label">Password</span>
            <span class="info-value">••••••••</span>
            <button class="edit-btn" id="btn-edit-pw" aria-label="Edit password">edit</button>
          </div>
        </div>

      </div><!-- /dp-content -->

      <!-- Delete button -->
      <div class="dp-footer">
        <button class="delete-btn" id="btn-hapus" aria-label="Hapus akun">HAPUS AKUN</button>
      </div>

    </section><!-- /detail-panel -->

  </div><!-- /main-card -->

</div><!-- /pg -->

<script>
  /* ── Edit photo placeholder ── */
  document.getElementById('btn-edit-photo').addEventListener('click', function() {
    alert('Pilih foto baru dari galeri.');
  });

  /* ── Three-dot menu placeholder ── */
  document.getElementById('btn-menu-dots').addEventListener('click', function() {
    alert('Opsi tambahan: Bagikan profil, Laporkan masalah.');
  });

  /* ── Edit username ── */
  document.getElementById('btn-edit-username').addEventListener('click', function() {
    var el  = document.getElementById('disp-username');
    var val = prompt('Username baru:', el.textContent.trim());
    if (val !== null && val.trim()) el.textContent = val.trim();
  });

  /* ── Edit email ── */
  document.getElementById('btn-edit-email').addEventListener('click', function() {
    var el  = document.getElementById('disp-email');
    var val = prompt('Email baru:', el.textContent.trim());
    if (val !== null && val.trim()) el.textContent = val.trim();
  });

  /* ── Edit password placeholder ── */
  document.getElementById('btn-edit-pw').addEventListener('click', function() {
    alert('Form ganti password akan ditampilkan di sini.');
  });

  /* ── Hapus akun ── */
  document.getElementById('btn-hapus').addEventListener('click', function() {
    if (confirm('⚠️ Hapus akun secara permanen?\nTindakan ini tidak dapat dibatalkan.')) {
      alert('Permintaan penghapusan akun dikirim.');
    }
  });
</script>

</body>
</html>
